# Application
APP_NAME=UDS Diagnostics Assistant
APP_ENV=development
DEBUG=true

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database (SQLite for pilot; swap to PostgreSQL DSN for production)
DATABASE_URL=sqlite:///./uds_assistant.db

# Vector DB (configured in a later stage)
VECTOR_DB_PATH=./data/vector_store

# Document storage (ingestion stage)
DOCUMENT_STORAGE_PATH=./data/documents

# Chunking (chunk size / overlap in characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Embeddings: "hash" (offline-safe default) or "sentence_transformers" (real, needs download)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.15

# API authentication. Empty disables auth (dev default). Set to require X-API-Key.
API_KEY=

# Real authentication. Empty JWT_SECRET disables login enforcement (dev default).
# Set both to require real login for project-scoped resources. Generate a
# random value in production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM ("mock" = deterministic offline default, safe for pilot/tests;
# "anthropic" = real grounded assistant, requires LLM_API_KEY via environment)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_BASE=
LLM_API_KEY=
